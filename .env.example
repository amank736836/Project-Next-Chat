# Copy to `.env.local` and fill in — `.env.local` is git-ignored:
#   cp .env.example .env.local
# Then restart the dev server (NEXT_PUBLIC_* values are inlined at build time).

# ---------------------------------------------------------------------------
# Realtime / remote backend
# ---------------------------------------------------------------------------
# Base URL of the Express + socket.io backend (NO trailing slash).
# Used by the browser for:
#   - the socket connection  (providers/SocketProvider.jsx -> constants/config.js)
#   - realtime-backed REST calls (redux/api/api.js -> `${url}/api/v1/...`)
NEXT_PUBLIC_SOCKET_SERVER_URL=https://mern-chatapp-backend-oyek.onrender.com

# Opt-in: authenticate against the remote backend straight from the browser
# instead of the local Next API routes (app/api/v1/user/*).
#
# Needed when the socket server is a separate origin: a session cookie set by
# this app is never sent to the backend's origin, so the socket handshake fails
# with "Please Login". Logging in on the backend puts the cookie where the
# socket (and the socket-backed REST calls) can send it.
#
# Requires NEXT_PUBLIC_SOCKET_SERVER_URL. Leave unset/false to keep using the
# local Next API routes (which need MONGODB_URI + JWT_SECRET).
NEXT_PUBLIC_REMOTE_AUTH=true

# ---------------------------------------------------------------------------
# Server-side (Next API routes, never exposed to the browser)
# ---------------------------------------------------------------------------
# Target of the /api/v1/[...slug] catch-all proxy for routes not implemented locally.
BACKEND_SERVER_URL=https://mern-chatapp-backend-oyek.onrender.com/api/v1
# Target used by app/api/v1/chat/ask-and-record.
SOCKET_BACKEND_URL=https://mern-chatapp-backend-oyek.onrender.com/api/v1

# ---------------------------------------------------------------------------
# Local auth + data (used by the Next API routes in app/api/v1/user/*)
# Must match the backend's values if you want the socket server to accept the
# same sessions (same JWT secret + same user collection).
# ---------------------------------------------------------------------------
MONGODB_URI=
# REQUIRED in production: signs all session tokens. If unset, the app falls
# back to a random per-process secret in production (sessions won't persist
# across restarts and cannot be forged). See SECURITY.md.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7
STEALTHY_NOTE_TOKEN_NAME=StealthyNoteToken
STEALTHY_NOTE_ADMIN_TOKEN_NAME=StealthyNoteAdminToken
# REQUIRED to use the admin portal in production (unset => admin login disabled).
ADMIN_SECRET_KEY=
# Cookie SameSite policy: strict | lax | none (default: lax). 'none' forces Secure.
COOKIE_SAMESITE=lax

# Cloudinary (attachments/avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (verification / password reset)
NODE_MAILER_EMAIL=
NODE_MAILER_PASSWORD=

# Public app URL used inside emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: AI features
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: NVIDIA NIM suggestions (fastest measured: nvidia/nemotron-3.5-lightning-30b-a3b).
# Get a key at https://build.nvidia.com — used by app/api/v1/chat/suggestMessages.
NVIDIA_API_KEY=

# Optional: serves the /dev/socket diagnostics page in production builds.
# Leave unset (anything other than "true" keeps the route 404).
ENABLE_DEV_TOOLS=

# Optional: dev-only. Comma-separated hosts allowed to fetch /_next/* resources
# (HMR, RSC) when the dev server is reached through a tunnel/preview proxy.
# Example: ALLOWED_DEV_ORIGINS=*.e2b.app
ALLOWED_DEV_ORIGINS=

# Optional: comma-separated allowlist of hosts next/image may fetch server-side
# (default: **.cloudinary.com, **.googleusercontent.com, **.gravatar.com).
NEXT_IMAGE_HOSTS=
